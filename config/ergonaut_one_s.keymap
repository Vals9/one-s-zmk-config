#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV 1
#define MOUSE 2
#define MEDIA 3
#define NUM 4
#define SYM 5
#define FUN 6
#define ADJ 7

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick_tap_ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        equal_sign {
            bindings = <&kp EQUAL>;
            key-positions = <8 7>;
            layers = <1>;
        };

        minus_sign {
            bindings = <&kp MINUS>;
            key-positions = <6 7>;
            layers = <1>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <3 2>;
            layers = <0>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <6 7>;
            layers = <0>;
        };

        forward_slash {
            bindings = <&kp BACKSLASH>;
            key-positions = <8 7>;
            layers = <0>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <18 17>;
            layers = <0>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <3 13>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <13 23>;
            layers = <0>;
        };

        tilde {
            bindings = <&kp GRAVE>;
            key-positions = <3 13>;
            layers = <1>;
        };

        F11_key {
            bindings = <&kp F11>;
            key-positions = <27 28>;
            layers = <1>;
        };

        F12_key {
            bindings = <&kp F12>;
            key-positions = <28 29>;
            layers = <1>;
        };
    };

    macros {
        virt_desktop_left: virt_desktop_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(LEFT))>;
            label = "VIRT_DESKTOP_LEFT";
        };

        virtl_desktop_right: virtl_desktop_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(RIGHT))>;
            label = "VIRTL_DESKTOP_RIGHT";
        };

        select_word_left: select_word_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(LEFT))>;
            label = "SELECT_WORD_LEFT";
        };

        select_word_right: select_word_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(RIGHT))>;
            label = "SELECT_WORD_RIGHT";
        };

        select_row_to_beginning: select_row_to_beginning {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(HOME)>;
            label = "SELECT_ROW_TO_BEGINNING";
        };

        select_row_to_end: select_row_to_end {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(END)>;
            label = "SELECT_ROW_TO_END";
        };

        jump_word_left: jump_word_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT)>;
            label = "JUMP_WORD_LEFT";
        };

        jump_word_right: jump_word_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(RIGHT)>;
            label = "JUMP_WORD_RIGHT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "MAIN";
            bindings = <
&kp Q       &kp W       &kp E             &kp R        &kp T      &kp Y  &kp U        &kp I              &kp O            &kp P
&hm LGUI A  &hm LALT S  &hm LEFT_SHIFT D  &hm LCTRL F  &kp G      &kp H  &hm RCTRL J  &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm LGUI SEMI
&kp Z       &kp X       &kp C             &kp V        &kp B      &kp N  &kp M        &kp COMMA          &kp DOT          &kp FSLH
                                          &mo 2        &kp SPACE  &mo 1  &kp ENTER    &kp BACKSPACE      &mo 1
            >;
        };

        sym_layer {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT   &kp CARET     &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp N7           &kp NUMBER_8  &kp NUMBER_9          &kp NUMBER_0
&kp F1           &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &kp F7           &kp F8        &kp F9                &kp F10
                                             &trans        &trans        &trans        &kp PRINTSCREEN  &kp DELETE    &trans
            >;
        };

        nav_edit_layer {
            bindings = <
&kp HOME        &kp UP_ARROW    &kp END             &kp PAGE_UP           &trans  &kp PAGE_UP    &select_word_left  &select_word_right  &select_row_to_beginning  &select_row_to_end
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW     &kp PAGE_DOWN         &trans  &kp PAGE_DOWN  &jump_word_left    &jump_word_right    &kp HOME                  &kp END
&trans          &trans          &virt_desktop_left  &virtl_desktop_right  &trans  &trans         &kp LEFT           &kp UP_ARROW        &kp DOWN                  &kp RIGHT
                                                    &trans                &trans  &trans         &trans             &trans              &trans
            >;
        };

        adj_layer {
            display-name = "ADJ";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4    &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
&bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &sys_reset    &bootloader     &bootloader     &sys_reset    &bt BT_NXT    &bt BT_PRV    &bt BT_CLR
&out OUT_TOG  &out OUT_BLE  &out OUT_USB  &none         &studio_unlock  &studio_unlock  &none         &out OUT_USB  &out OUT_BLE  &out OUT_TOG
                                          &none         &none           &none           &none         &none         &none
            >;
        };
    };
};
